# Copy to .env and fill in. Never commit .env.
# See README "Extracting credentials" for where each value comes from.

# Authorization header on every api.resy.com request:  ResyAPI api_key="<this>"
RESY_API_KEY=

# X-Resy-Auth-Token header on every logged-in request. Expires; re-extract when the bot exits with an auth error.
RESY_AUTH_TOKEN=

# struct_payment_method={"id":<this>} in the POST body to /3/book. Numeric.
RESY_PAYMENT_METHOD_ID=

# Optional, only when notify.provider is "telegram" in config.yaml. Token from @BotFather (README "Telegram").
TELEGRAM_BOT_TOKEN=
